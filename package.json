{
  "name": "kuha",
  "version": "1.0.0",
  "description": "Kuha - download videos as MP4 or MP3",
  "main": "main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "electron .",
    "fetch-tools": "powershell -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "dewdew-del",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dewdewdel.kuha",
    "productName": "Kuha",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kuha",
      "artifactName": "Kuha-Setup-${version}.exe"
    }
  }
}
